{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "honestping-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-07",
  "account_id": "4e7e5db788ca85b49af0442d922ebc6e",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // Keep the custom domains that already point at this Worker.
  "routes": [
    { "pattern": "honestping.com", "custom_domain": true, "enabled": true, "previews_enabled": false },
    { "pattern": "www.honestping.com", "custom_domain": true, "enabled": true, "previews_enabled": false }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "honestping-waitlist",
      "database_id": "c732d15a-f4c9-4f7d-8588-41f7774d41d1",
      "preview_database_id": "834af7c2-165f-4fb4-92b9-49b1aa0b3eb6",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "ansonmitchell@gmail.com",
      "allowed_sender_addresses": ["waitlist@honestping.com"]
    }
  ],
  "vars": {
    "TURNSTILE_HOSTNAMES": "www.honestping.com,honestping.com"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET"]
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "honestping-waitlist-preview",
        "database_id": "834af7c2-165f-4fb4-92b9-49b1aa0b3eb6",
        "migrations_dir": "migrations"
      }
    ],
    "send_email": [
      {
        "name": "EMAIL",
        "destination_address": "ansonmitchell@gmail.com",
        "allowed_sender_addresses": ["waitlist@honestping.com"]
      }
    ],
    "vars": {
      "TURNSTILE_HOSTNAMES": ".honestping.pages.dev"
    }
  }
}
