{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "honestping-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-07",
  "account_id": "4e7e5db788ca85b49af0442d922ebc6e",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // Keep the custom domains that already point at this Worker.
  "routes": [
    { "pattern": "honestping.com", "custom_domain": true, "enabled": true, "previews_enabled": false },
    { "pattern": "www.honestping.com", "custom_domain": true, "enabled": true, "previews_enabled": false }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "honestping-waitlist",
      "database_id": "c732d15a-f4c9-4f7d-8588-41f7774d41d1",
      "preview_database_id": "834af7c2-165f-4fb4-92b9-49b1aa0b3eb6",
      "migrations_dir": "migrations"
    }
  ],
  // Screenshots are private objects. The row stores the key only.
  // honestping-feedback is the production bucket. This change does not create it.
  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "honestping-feedback",
      "preview_bucket_name": "honestping-feedback-preview"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "hello@honestping.com",
      "allowed_sender_addresses": ["hello@honestping.com"]
    }
  ],
  "vars": {
    "TURNSTILE_HOSTNAMES": "www.honestping.com,honestping.com",
    "K_MIN": "10"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET", "FEEDBACK_IP_SALT"]
  },
  // Placeholder ids. This change does not create the namespace.
  // Replace them with `wrangler kv namespace create` output before a deploy.
  "kv_namespaces": [
    {
      "binding": "FEEDBACK_LIMITS",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    }
  ],
  // */15 retries unsent mail. 15 3 * * * is 03:15 UTC feedback retention.
  // env.preview sets the same crons again so a preview deploy does not depend on inheritance.
  "triggers": {
    "crons": ["*/15 * * * *", "15 3 * * *"]
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "honestping-waitlist-preview",
        "database_id": "834af7c2-165f-4fb4-92b9-49b1aa0b3eb6",
        "migrations_dir": "migrations"
      }
    ],
    "r2_buckets": [
      {
        "binding": "SCREENSHOTS",
        "bucket_name": "honestping-feedback-preview"
      }
    ],
    "send_email": [
      {
        "name": "EMAIL",
        "destination_address": "hello@honestping.com",
        "allowed_sender_addresses": ["hello@honestping.com"]
      }
    ],
    "vars": {
      "TURNSTILE_HOSTNAMES": "honestping-web-preview.honestping.workers.dev",
      "ORIGIN_BASE": "https://raw.githubusercontent.com/ansonmitchell-lab/honestping-website/cursor/waitlist-d1-bbe4",
      "K_MIN": "10"
    },
    "kv_namespaces": [
      {
        "binding": "FEEDBACK_LIMITS",
        "id": "00000000000000000000000000000000"
      }
    ]
  },
  // Deploy with: wrangler deploy --config wrangler.worker.jsonc --env preview
  // Wrangler names this script honestping-web-preview (top-level name plus the env).
  // Do not set "name" here: Wrangler would append "-preview" again.
  // "routes": [] stops this env from taking honestping.com away from honestping-web.
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "honestping-waitlist-preview",
          "database_id": "834af7c2-165f-4fb4-92b9-49b1aa0b3eb6",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SCREENSHOTS",
          "bucket_name": "honestping-feedback-preview"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "destination_address": "hello@honestping.com",
          "allowed_sender_addresses": ["hello@honestping.com"]
        }
      ],
      "vars": {
        "TURNSTILE_HOSTNAMES": "honestping-web-preview.honestping.workers.dev",
        "ORIGIN_BASE": "https://raw.githubusercontent.com/ansonmitchell-lab/honestping-website/cursor/waitlist-d1-bbe4",
        "K_MIN": "10"
      },
      "secrets": {
        "required": ["TURNSTILE_SECRET", "FEEDBACK_IP_SALT"]
      },
      "kv_namespaces": [
        {
          "binding": "FEEDBACK_LIMITS",
          "id": "00000000000000000000000000000000"
        }
      ],
      "triggers": {
        "crons": ["*/15 * * * *", "15 3 * * *"]
      }
    }
  }
}
